#!/usr/bin/env python3
"""
ops - Standalone Zero-Dependency CLI for Hermes Agent
Communicates with the Operatives comment-scraping internal bridge API
and prints compact, token-safe JSON summaries (< 3 KB) to stdout.

Install inside hermes-agent container:
    cp ops /usr/local/bin/ops && chmod +x /usr/local/bin/ops

Environment Variables (optional):
    OPS_API_URL  (default: auto-discovers http://operatives-bridge:8080 or http://172.17.0.1:8080)
    OPS_API_KEY  (optional API key if configured on the bridge)
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

CANDIDATE_URLS = [
    "http://10.0.4.1:18890",
    "http://172.17.0.1:18890",
    "http://host.docker.internal:18890",
    "http://bot-controller:18890",
    "http://127.0.0.1:18890",
]


def resolve_base_url() -> str:
    env_url = os.environ.get("OPS_API_URL", "").strip().rstrip("/")
    if env_url:
        return env_url
    for candidate in CANDIDATE_URLS:
        try:
            req = urllib.request.Request(f"{candidate}/health", method="GET")
            with urllib.request.urlopen(req, timeout=1.5) as resp:
                if resp.status == 200:
                    return candidate
        except Exception:
            continue
    return CANDIDATE_URLS[0]


def api_request(path: str, method: str = "GET", params: dict = None, body: dict = None, timeout: int = 90) -> dict:
    base_url = resolve_base_url()
    url = f"{base_url}{path}"
    if params:
        clean_params = {k: v for k, v in params.items() if v is not None and v != ""}
        if clean_params:
            url += "?" + urllib.parse.urlencode(clean_params)

    headers = {"Accept": "application/json"}
    api_key = os.environ.get("OPS_API_KEY", "").strip()
    if api_key:
        headers["X-API-Key"] = api_key

    data = None
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8")
            return json.loads(raw)
    except urllib.error.HTTPError as e:
        try:
            err_body = json.loads(e.read().decode("utf-8"))
        except Exception:
            err_body = {"error": f"HTTP {e.code}: {e.reason}"}
        return err_body
    except Exception as e:
        return {
            "error": f"Failed to reach comment-scraping bridge at {base_url}: {e}",
            "hint": "Set OPS_API_URL=http://<bridge-host>:8080 or ensure containers share the coolify network.",
        }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ops",
        description=(
            "Operatives Intelligence CLI for Hermes Agent.\n"
            "CRITICAL EXECUTION RULES:\n"
            "  1. NEVER wrap `ops video` or `curl .../api/video` in a bash `for`/`while` loop or poll with `sleep` > 10s.\n"
            "  2. Call `ops video` at most ONCE per video. If it returns `deterministic_failure: true` or HTTP 504, STOP IMMEDIATELY and fall back to metadata/comments.\n"
            "  3. NEVER write custom Python/bash transcript scrapers (vidjob.py, yt-dlp subtitle loops, Invidious, etc.).\n"
            "  4. When asked about company finances or spreadsheets, use the `sheets` CLI (`sheets list`, `sheets read`, `sheets update`, `sheets append`) to inspect and update Google Sheets."
        ),
        formatter_class=argparse.RawTextHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # 1. ops digest
    p_digest = sub.add_parser(
        "digest",
        help="Summarize activity and flagged hostile comments over the last N hours.",
    )
    p_digest.add_argument("--hours", type=int, default=24, help="Lookback window in hours (default: 24)")
    p_digest.add_argument(
        "--platform",
        type=str,
        default="",
        help="Filter by platform: telegram, instagram, youtube, x, facebook",
    )
    p_digest.add_argument("--min-score", type=int, default=7, help="Minimum severity score 0-10 (default: 7)")
    p_digest.add_argument("--limit", type=int, default=12, help="Max flagged comments to return (default: 12)")

    # 2. ops check
    p_check = sub.add_parser(
        "check",
        help="Inspect a monitored post/channel or list an Instagram profile's last 5 posts (@username).",
    )
    p_check.add_argument(
        "target",
        nargs="?",
        default="list",
        help="Target UUID, shortcode, @username, or URL (default: 'list' all monitored targets)",
    )
    p_check.add_argument("--limit", type=int, default=10, help="Max flagged comments to include (default: 10)")

    # 3. ops scrape
    p_scrape = sub.add_parser(
        "scrape",
        help="Scrape + evaluate a post URL or an Instagram profile (@username -> latest or Nth post).",
    )
    p_scrape.add_argument(
        "url",
        type=str,
        help="Post URL, Instagram profile (@username / instagram.com/username), or Telegram @channel",
    )
    p_scrape.add_argument(
        "--post-index",
        "-i",
        type=int,
        default=1,
        help="For Instagram profiles: 1 = most recent post (default), 2 = 2nd most recent, etc.",
    )
    p_scrape.add_argument(
        "--posts",
        type=int,
        default=0,
        help="Optional: scrape & aggregate across the last N posts (1-5) of a profile",
    )
    p_scrape.add_argument(
        "--monitor",
        action="store_true",
        help="Keep target active in 5-minute background cron schedule (default: false for one-off scrapes)",
    )
    p_scrape.add_argument(
        "--no-wait",
        action="store_true",
        help="Enqueue background job and return immediately instead of waiting for LLM evaluation",
    )
    p_scrape.add_argument("--limit", type=int, default=200, help="Max comments to scrape (default: 200)")

    # 3b. ops profile
    p_profile = sub.add_parser(
        "profile",
        help="Analyze an Instagram, X, Facebook, or YouTube profile across its last N posts (bio, followers, cadence, comments, threats).",
    )
    p_profile.add_argument("handle", type=str, help="Profile @handle or URL (Instagram, X, Facebook, YouTube)")
    p_profile.add_argument("--platform", type=str, default="", help="Optional platform filter: instagram, x, facebook, youtube")
    p_profile.add_argument("--posts", type=int, default=3, help="Number of recent posts to analyze (default: 3, max: 5)")
    p_profile.add_argument("--limit", type=int, default=80, help="Max comments per post (default: 80)")
    p_profile.add_argument("--no-scrape", action="store_true", help="Only fetch profile & post metadata without scraping comments")

    # 3c. ops posts
    p_posts = sub.add_parser(
        "posts",
        help="List a profile's recent posts with comment/like counts and shortcodes.",
    )
    p_posts.add_argument("handle", type=str, help="Profile @handle or URL")
    p_posts.add_argument("--platform", type=str, default="", help="Optional platform filter: instagram, x, facebook, youtube")
    p_posts.add_argument("--count", type=int, default=5, help="Number of recent posts to list (default: 5, max: 10)")

    # 3d. ops replies
    p_replies = sub.add_parser(
        "replies",
        help="Fetch an X user's own recent replies (tweet_type='Replies') and score them via DeepSeek.",
    )
    p_replies.add_argument("handle", type=str, help="X @handle or profile URL (e.g. @username or https://x.com/username)")
    p_replies.add_argument("--limit", "--count", dest="limit", type=int, default=20, help="Number of recent replies to fetch and evaluate (default: 20)")

    # 3d-2. ops video (also aliased as ops analyze)
    for v_cmd in ("video", "analyze"):
        p_video = sub.add_parser(
            v_cmd,
            help=(
                "Analyze a YouTube video via Google Gemini (SINGLE ATTEMPT ONLY — NEVER loop or retry on 504/deterministic_failure).\n"
                "  Option 1 (default): Pass YouTube URL directly to Gemini for compact video summary, key moments, claims & query answers (--mode video).\n"
                "  Option 2 (--reactions): Analyze video content via Gemini AND correlate viewer reactions from scraped comments."
            ),
        )
        p_video.add_argument("url", type=str, help="YouTube video URL, 11-char video ID, or YouTube channel @handle")
        p_video.add_argument(
            "--mode",
            type=str,
            choices=["video", "reactions"],
            default="video",
            help="Analysis mode: 'video' (Option 1: video content only) or 'reactions' (Option 2: video + comment reactions)",
        )
        p_video.add_argument(
            "--reactions",
            "--with-reactions",
            "--with-comments",
            dest="reactions",
            action="store_true",
            help="Enable Option 2: scrape & evaluate comments and correlate viewer reactions with specific parts of the video",
        )
        p_video.add_argument(
            "--focus",
            "--query",
            "--question",
            "-q",
            dest="focus",
            type=str,
            default="",
            help="Optional specific question, query, timestamp, or topic in the video to answer",
        )
        p_video.add_argument(
            "--limit",
            type=int,
            default=100,
            help="Max comments to scrape and evaluate when in --reactions (Option 2) mode (default: 100)",
        )
        p_video.add_argument(
            "--post-index",
            type=int,
            default=1,
            help="If a YouTube @channel is passed instead of a video URL: 1 = latest video, 2 = 2nd latest, etc.",
        )
        p_video.add_argument(
            "--lang",
            type=str,
            default="",
            help="Optional preferred language hint (e.g. 'uz,ru,en')",
        )

    # 3e. ops untarget
    p_untarget = sub.add_parser(
        "untarget",
        help="Deactivate or delete a monitored target by ID, shortcode, or handle.",
    )
    p_untarget.add_argument("target", type=str, help="Target shortcode, UUID, or @handle")
    p_untarget.add_argument("--delete", action="store_true", help="Permanently delete target instead of deactivating")

    # 4. ops search
    p_search = sub.add_parser(
        "search",
        help="Search stored comments in PostgreSQL by keyword/reason or audit status/failures.",
    )
    p_search.add_argument("query", nargs="?", default="", help="Keyword or phrase to search in text or LLM reason")
    p_search.add_argument("--platform", type=str, default="", help="Optional platform filter")
    p_search.add_argument("--min-score", type=int, default=0, help="Optional minimum severity score (default: 0)")
    p_search.add_argument(
        "--status",
        type=str,
        default="",
        help="Filter by llm_status: evaluated, failed, pending, skipped_prefilter",
    )
    p_search.add_argument("--failed", action="store_true", help="Shortcut for --status failed")
    p_search.add_argument("--limit", type=int, default=12, help="Max matching comments to return (default: 12)")

    # 5. ops sessions
    p_sessions = sub.add_parser(
        "sessions",
        help="Check burner account health, reset cooldowns, or add a new burner session / proxy.",
    )
    p_sessions.add_argument("--platform", type=str, default="", help="Optional platform filter (instagram, x, facebook, youtube)")
    p_sessions.add_argument("--reset", action="store_true", help="Reset all cooldown timers and reactivate accounts")
    p_sessions.add_argument(
        "--proxy",
        type=str,
        default=None,
        help="Optional proxy URL (e.g. http://user:pass@host:port or socks5://...)",
    )
    p_sessions.add_argument(
        "--add",
        nargs=3,
        metavar=("PLATFORM", "ACCOUNT", "COOKIES"),
        help="Add a burner session: --add x my_burner '{\"auth_token\":\"...\",\"ct0\":\"...\"}' (or --add youtube yt_proxy '{}' --proxy http://...)",
    )

    # 6. ops sheets (also available as standalone `sheets` CLI)
    p_sheets = sub.add_parser(
        "sheets",
        help="When asked about company finances or spreadsheets, inspect and update Google Sheets (list, read, update, append).",
    )
    p_sheets.add_argument("action", choices=["list", "read", "update", "append"], help="Action: list, read, update, append")
    p_sheets.add_argument("args", nargs="*", help="Arguments for the action: [sheet_name_or_id] [range] [values_json]")

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    if args.command == "digest":
        res = api_request(
            "/api/digest",
            params={
                "hours": args.hours,
                "platform": args.platform,
                "min_score": args.min_score,
                "limit": args.limit,
            },
        )
    elif args.command == "check":
        res = api_request(
            "/api/check",
            params={"target": args.target, "limit": args.limit},
        )
    elif args.command == "scrape":
        res = api_request(
            "/api/scrape",
            method="POST",
            body={
                "url": args.url,
                "post_index": args.post_index,
                "posts": args.posts if args.posts > 0 else None,
                "monitor": args.monitor,
                "wait": not args.no_wait,
                "limit": args.limit,
            },
            timeout=240,
        )
    elif args.command == "profile":
        res = api_request(
            "/api/profile",
            method="POST",
            body={
                "handle": args.handle,
                "platform": getattr(args, "platform", "") or None,
                "posts": args.posts,
                "limit": args.limit,
                "scrape": not args.no_scrape,
            },
            timeout=240,
        )
    elif args.command == "posts":
        res = api_request(
            "/api/posts",
            params={
                "target": args.handle,
                "platform": getattr(args, "platform", "") or None,
                "count": args.count,
            },
        )
    elif args.command == "replies":
        res = api_request(
            "/api/replies",
            method="POST",
            body={"handle": args.handle, "limit": args.limit},
            timeout=180,
        )
    elif args.command in ("video", "analyze"):
        effective_mode = "reactions" if (args.reactions or args.mode == "reactions") else "video"
        res = api_request(
            "/api/video",
            method="POST",
            body={
                "url": args.url,
                "mode": effective_mode,
                "reactions": effective_mode == "reactions",
                "focus": args.focus or None,
                "limit": args.limit,
                "post_index": args.post_index,
                "lang": args.lang or None,
            },
            timeout=480,
        )
    elif args.command == "untarget":
        res = api_request(
            "/api/target/delete",
            method="POST",
            body={"target": args.target, "delete": args.delete},
        )
    elif args.command == "search":
        res = api_request(
            "/api/search",
            params={
                "q": args.query,
                "platform": args.platform,
                "min_score": args.min_score,
                "status": "failed" if args.failed else args.status,
                "failed": "true" if args.failed else "",
                "limit": args.limit,
            },
        )
    elif args.command == "sessions":
        if args.add:
            plat, acct, cooks = args.add
            res = api_request(
                "/api/sessions",
                method="POST",
                body={
                    "platform": plat,
                    "account": acct,
                    "cookies": cooks,
                    "proxy_url": args.proxy,
                    "reset": args.reset,
                },
            )
        else:
            res = api_request(
                "/api/sessions",
                params={
                    "platform": args.platform,
                    "reset": "true" if args.reset else "false",
                },
            )
    elif args.command == "sheets":
        act = args.action
        s_args = args.args or []
        if act == "list":
            res = api_request("/api/sheets", params={"action": "list"})
        elif act == "read":
            if not s_args:
                res = {"error": "Usage: ops sheets read <sheet_name_or_id> [range]"}
            else:
                res = api_request(
                    "/api/sheets",
                    params={
                        "action": "read",
                        "sheet": s_args[0],
                        "range": s_args[1] if len(s_args) > 1 else "",
                    },
                )
        elif act == "update":
            if len(s_args) < 3:
                res = {"error": "Usage: ops sheets update <sheet_name_or_id> <range> <values_json>"}
            else:
                res = api_request(
                    "/api/sheets",
                    method="POST",
                    body={
                        "action": "update",
                        "sheet": s_args[0],
                        "range": s_args[1],
                        "values": s_args[2],
                    },
                )
        elif act == "append":
            if len(s_args) < 2:
                res = {"error": "Usage: ops sheets append <sheet_name_or_id> <values_json>"}
            else:
                res = api_request(
                    "/api/sheets",
                    method="POST",
                    body={
                        "action": "append",
                        "sheet": s_args[0],
                        "range": s_args[2] if len(s_args) > 2 else "",
                        "values": s_args[1],
                    },
                )
    else:
        parser.print_help()
        sys.exit(1)

    print(json.dumps(res, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
